{
  "name": "voice-input",
  "version": "0.4.1",
  "private": true,
  "description": "Ditado por voz 100% local, focado em termos técnicos",
  "main": "dist/main/index.js",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build:ts": "tsc -p tsconfig.json",
    "build:static": "node scripts/copy-static.mjs",
    "build:app": "npm run build:ts && npm run build:static",
    "build:helper": "bash scripts/build-helper.sh",
    "build": "npm run build:app && npm run build:helper",
    "package": "bash scripts/package.sh",
    "dist:win": "npm run build:app && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build:app && electron-builder --linux --x64 --publish never",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "bench": "node scripts/benchmark.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.voiceinput.app",
    "productName": "Voice Input",
    "directories": {
      "output": "dist-app",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/logo.png",
      "category": "Utility",
      "maintainer": "Kaique Oliveira",
      "synopsis": "Ditado por voz 100% local"
    }
  },
  "author": {
    "name": "Kaique Oliveira",
    "email": "19419231+kaique-oliveira@users.noreply.github.com"
  },
  "homepage": "https://github.com/kaique-oliveira/voice-input",
  "license": "MIT"
}
